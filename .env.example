# Plantilla de variables de entorno de RIUL.
# Copiar este archivo como `.env` y completar los valores.

# --- Base de datos MySQL (contenedor `db`) ---
MYSQL_DATABASE=nombre_de_la_base
MYSQL_USER=usuario_de_la_base
MYSQL_PASSWORD=contrasena_del_usuario
MYSQL_ROOT_PASSWORD=contrasena_del_administrador

# URL de conexion de SQLAlchemy con MySQL (el host es el nombre del servicio: `db`)
DATABASE_URL=mysql+pymysql://usuario_de_la_base:contrasena_del_usuario@db:3306/nombre_de_la_base

# --- Seguridad ---
JWT_SECRET_KEY=una-clave-larga-y-aleatoria

# --- Datos de la interfaz ---
# true: datos simulados en el navegador. false: API real del servidor.
USE_MOCKS=true
